# Settings for tpu.sh. Copy to ~/.config/ontologize/cloud.env (or point
# ONTO_CLOUD_ENV at another path outside the repository) and fill in. Keep
# project, bucket and account names out of the repository.

# required
ONTO_PROJECT=your-gcp-project
ONTO_ZONE=us-west4-a                  # flex-start v5e is offered here
ONTO_BUCKET=gs://your-bucket/onto      # in the zone's region, so the VM's reads are free

# optional (defaults shown)
# PATH="/path/to/google-cloud-sdk/bin:$PATH"   # a newer gcloud than the system's, for tpu.sh
#                                              # alone (SDK 491 lacks flex-start's flags; 594 has them)
# ONTO_NODE=onto-tpu
# ONTO_ACCELERATOR=v5litepod-4         # 4 chips, 192 GB host RAM
# ONTO_RUNTIME=                        # derived from the accelerator
# ONTO_PROVISIONING=flex               # flex | spot | ondemand
# ONTO_HOURS=24                        # flex-start run time; the node is deleted after it
# ONTO_RAM_GB=                         # hold data/ in a tmpfs of this size on the VM
# ONTO_PRECISION=high                  # JAX matmul precision for jobs that don't set it
# ONTO_SYNC_EVERY=120                  # seconds between syncs of a running job
