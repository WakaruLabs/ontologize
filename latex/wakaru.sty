%% wakaru.sty — the Wakaru paper style, from branding kit 0.1.1.
%%
%% The kit (colors.txt, style-guide.txt, logo.svg, swords.svg, wugaru.svg)
%% set for print and for arXiv:
%%   - pdflatex only, and one file: the three marks are drawn in TikZ from
%%     the kit's SVG paths, so there is no image to ship or convert.
%%   - black text on white. Wakaru pink is the brand colour: it carries the
%%     heading numbers, the folio and the emblem. The masthead's field is
%%     the kit's lilac, which sets the pink off, and text-sized pink (links,
%%     eyebrows) takes the darker shade, which stays legible on white.
%%   - the kit's box is the style's one shape: a black border on a field,
%%     heavier on the bottom and right (a hard drop shadow merged into the
%%     border), with rounded corners. It holds the masthead, the abstract,
%%     quotations and the folio; on a black field with white text it is the
%%     chip that labels figures, tables and the abstract.
%%     The kit's pixel sizes are scaled by 0.375pt per px, which keeps their
%%     proportions: 4px -> 1.5pt, 3px -> 1.125pt, 30px -> 11.25pt, 20px ->
%%     7.5pt.
%%   - Noto, the kit's family: Noto Sans for the title, headings, labels,
%%     chips and table column heads, Noto Serif for the text, and notomath
%%     for the math, with lining figures. Code is set in IBM Plex Mono;
%%     option [noto] sets it in Noto Sans Mono instead.
%%
%% Usage: \usepackage{wakaru} on top of \documentclass{article}; with
%% [biblatex] when the document loads biblatex itself (after this package).
%% For documents: \eyebrow, \runningtitle and \imprint before \maketitle;
%% the abstract environment; \mutedlabel and \wakarulabel for small sans
%% labels; \wakaruchip; \wakarubox and the wakaruframe and wakaruquote
%% environments.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{wakaru}[2026/11/11 v0.2 Wakaru paper style (branding kit 0.1.1)]

\newif\if@wakarubiblatex
\@wakarubiblatexfalse
\newif\if@wakarunoto
\@wakarunotofalse
\DeclareOption{biblatex}{\@wakarubiblatextrue}
\DeclareOption{noto}{\@wakarunototrue}
\ProcessOptions\relax

%% ---- colour: the kit's colors.txt, in its order -----------------------------

\RequirePackage[table]{xcolor}
\definecolor{wakarupink}{HTML}{FF119C}     % the brand colour
\definecolor{wakarulemon}{HTML}{FFFEAA}    % fill
\definecolor{wakaruice}{HTML}{E5FFFE}      % fill
\definecolor{wakarulilac}{HTML}{C6C0EC}    % fill
\definecolor{wakaruiris}{HTML}{6B6DD6}     % fill
\definecolor{wakarupinkdark}{HTML}{9F0E63} % darker shade of the pink
\definecolor{wakarupinkdeep}{HTML}{720046} % darkest shade

% The masthead's field; \colorlet{wakarumast}{wakarupink} gives the kit's
% default arrangement, pink behind the white card.
\colorlet{wakarumast}{wakarulilac}

% The folio's field: a light tint of the pink, which the black border and
% numeral sit on more quietly than the full colour.
\colorlet{wakarufolio}{wakarupink!25}

% Tints of black for secondary text and hairlines; the kit has no grey.
\colorlet{wakarumuted}{black!62}
\colorlet{wakarurule}{black!22}

%% ---- type -------------------------------------------------------------------

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
% amsmath and amsthm must precede the math fonts (the newtxmath that
% notomath loads): it supplies the AMS symbols itself, so amssymb after it
% clashes.
\RequirePackage{amsmath}
\RequirePackage{amsthm}
% The typewriter face loads first, so that newtxmath takes \mathtt from it
% and code in math matches code in text. Noto Sans Mono runs wide, so it
% is set smaller than the text beside it.
\if@wakarunoto
  \RequirePackage[type1,scale=0.8]{noto-mono}
\else
  \IfFileExists{plex-mono.sty}%
    {\RequirePackage[scale=0.82]{plex-mono}}%
    {\RequirePackage[scaled=0.82]{beramono}}
\fi
% notomath loads Noto Serif and Noto Sans at 0.9 of the math's size, and
% newtxmath with Noto's letters, so text and math are one family
\RequirePackage{notomath}

\RequirePackage[final]{microtype}
% typewriter text is code and command-line flags, which print as typed
\DisableLigatures[-]{encoding = *, family = tt*}

%% ---- page -------------------------------------------------------------------

\RequirePackage[
  letterpaper,
  textwidth=6in,
  textheight=9in,
  hcentering,
  top=1in,
  headheight=14pt,
]{geometry}

% Noto Serif's x-height is tall for its size, so its lines are set open
\linespread{1.12}
\setlength{\parskip}{0pt}
\setlength{\parindent}{1.5em}

%% ---- the marks ----------------------------------------------------------------

\RequirePackage{tikz}

\newdimen\wk@u   % a mark's height, the unit its paths are written in
\newdimen\wk@lw

