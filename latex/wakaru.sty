% Wordmark with "Labs" after it, as the kit allows: \wakarulabs[colour]{height}
\newcommand{\wakarulabs}[2][black]{%
  \begingroup
  \wk@u=#2\relax
  \wakarulogo[#1]{\wk@u}\kern0.34\wk@u
  {\sffamily\fontseries{m}\fontsize{\strip@pt\dimexpr1.32\wk@u\relax}{0}\selectfont
   \color{#1}Labs}%
  \endgroup
}

%% ---- the box ------------------------------------------------------------------

\newlength{\wakaruborder}      \setlength{\wakaruborder}{1.5pt}
\newlength{\wakarushadow}      \setlength{\wakarushadow}{1.125pt}
\newlength{\wakaruradius}      \setlength{\wakaruradius}{11.25pt}
\newlength{\wakarusmallradius} \setlength{\wakarusmallradius}{7.5pt}

\newsavebox{\wk@box}
\newdimen\wk@w   % content width
\newdimen\wk@W   % width to the border's outer edge
\newdimen\wk@H   % height to the border's outer edge

\pgfkeys{/wakaru/box/.cd,
  width/.store in=\wk@kwidth,
  fill/.store in=\wk@kfill,
  frame/.store in=\wk@kframe,
  radius/.store in=\wk@kradius,
  pad/.store in=\wk@kpad,
  border/.store in=\wk@kborder,
  shadow/.store in=\wk@kshadow,
  large/.style={radius=\wakaruradius},
  plain/.style={border=0pt, shadow=0pt},
}

% Width is the whole box's, shadow included, so a box fills the measure.
\newcommand{\wk@setup}[1]{%
  \pgfkeys{/wakaru/box/.cd,
    width=\linewidth, fill=white, frame=black, radius=\wakarusmallradius,
    pad=10pt, border=\wakaruborder, shadow=\wakarushadow, #1}%
  \wk@W=\dimexpr\wk@kwidth-\wk@kshadow\relax
  \wk@w=\dimexpr\wk@W-\wk@kpad-\wk@kpad-\wk@kborder-\wk@kborder\relax
}

\newcommand{\wk@draw}{%
  \wk@H=\dimexpr\ht\wk@box+\dp\wk@box+\wk@kpad+\wk@kpad+\wk@kborder+\wk@kborder\relax
  % every coordinate as a plain length, so TikZ parses no arithmetic
  \edef\wk@s{\the\dimexpr\wk@kshadow\relax}%
  \edef\wk@b{\the\dimexpr\wk@kborder\relax}%
  \edef\wk@hb{\the\dimexpr0.5\dimexpr\wk@kborder\relax\relax}%
  \edef\wk@r{\the\dimexpr\wk@kradius\relax}%
  \edef\wk@ri{\the\dimexpr\wk@r-\wk@hb\relax}%
  \edef\wk@in{\the\dimexpr\wk@b+\wk@kpad\relax}%
  \edef\wk@xs{\the\dimexpr\wk@W+\wk@s\relax}%
  \edef\wk@ys{\the\dimexpr\wk@H+\wk@s\relax}%
  \edef\wk@xb{\the\dimexpr\wk@W-\wk@hb\relax}%
  \edef\wk@yb{\the\dimexpr\wk@H-\wk@hb\relax}%
  \begin{tikzpicture}
    \path[use as bounding box] (0pt,0pt) rectangle (\wk@xs,-\wk@ys);
    \ifdim\wk@s>0pt
      \fill[\wk@kframe, rounded corners=\wk@r] (\wk@s,-\wk@s) rectangle (\wk@xs,-\wk@ys);
    \fi
    \ifdim\wk@b>0pt
      \path[fill=\wk@kfill, draw=\wk@kframe, line width=\wk@b, rounded corners=\wk@ri]
        (\wk@hb,-\wk@hb) rectangle (\wk@xb,-\wk@yb);
    \else
      \fill[\wk@kfill, rounded corners=\wk@r] (0pt,0pt) rectangle (\the\wk@W,-\the\wk@H);
    \fi
    \node[anchor=north west, inner sep=0pt, outer sep=0pt, text=black]
      at (\wk@in,-\wk@in) {\usebox{\wk@box}};
  \end{tikzpicture}%
}

% \wakarubox[keys]{content} and \begin{wakaruframe}[keys] ... \end{wakaruframe}
% set content in the kit's box; neither breaks across pages. Keys: width,
% fill, frame, radius, pad, border, shadow; large (the large-element radius);
% plain (no border or shadow: a field of colour). The environment takes
% verbatim material, the command does not.
\newcommand{\wakarubox}[2][]{%
  \begingroup
  \wk@setup{#1}%
  \sbox{\wk@box}{\begin{minipage}{\wk@w}#2\end{minipage}}%
  \wk@draw
  \endgroup
}
\newenvironment{wakaruframe}[1][]{%
  \wk@setup{#1}%
  \begin{lrbox}{\wk@box}\begin{minipage}{\wk@w}%
}{%
  \end{minipage}\end{lrbox}%
  \wk@draw
}

%% ---- labels and chips -----------------------------------------------------------

% \wakarulabel{...}: small Noto Sans semibold, set as typed.
\newcommand{\wakarulabel}[1]{%
  {\sffamily\fontseries{sb}\fontsize{7.5}{9}\selectfont#1}%
}
\newcommand{\mutedlabel}[1]{{\color{wakarumuted}\wakarulabel{#1}}}

% \wakaruchip[fill]{text}: white Noto Sans bold on a small rounded field
% (black by default), on the baseline. The field reaches 6.6pt above the
% baseline and 2.2pt below it, inside a line of \small text, so a chip
% that starts a line does not open the leading.
\newsavebox{\wk@chip}
\newcommand{\wakaruchip}[2][black]{%
  \begingroup
  \sbox{\wk@chip}{\sffamily\bfseries\fontsize{7.5}{9}\selectfont\color{white}#2}%
  \edef\wk@cx{\the\dimexpr\wd\wk@chip+3.2pt\relax}%
  \begin{tikzpicture}[baseline=0pt]
    \fill[#1, rounded corners=2.4pt] (-3.2pt,-2.2pt) rectangle (\wk@cx,6.6pt);
    \node[anchor=base west, inner sep=0pt, outer sep=0pt] at (0pt,0pt)
      {\usebox{\wk@chip}};
  \end{tikzpicture}%
  \endgroup
}

%% ---- title block ----------------------------------------------------------------

% \eyebrow{Note 002 · evaluations}: set opposite the wordmark, with the
% date under it.
\newcommand{\@wakarueyebrow}{}
\newcommand{\eyebrow}[1]{\renewcommand{\@wakarueyebrow}{#1}}

% The wordmark on the masthead: \wakarulogo by default; a document of the
% lab's can \renewcommand{\wakarumastmark}{\wakarulabs{13pt}}.
\newcommand{\wakarumastmark}{\wakarulogo{13pt}}

% The masthead is the kit's default arrangement in another of its colours:
% a field of wakarumast, and on it a white card with the heavy border, the
% text in black on the white. The eyebrow and the date sit on the field
% beside the wordmark, which keeps the card to the title and the authors.
\renewcommand{\maketitle}{%
  \begingroup
  \thispagestyle{firstpage}%
  \noindent
  \wakarubox[plain, large, fill=wakarumast, pad=9pt]{%
    \raggedright
    \sbox{\@tempboxa}{\wakarumastmark}%
    \noindent\usebox{\@tempboxa}\hfill
    \begin{minipage}[b]{\dimexpr\linewidth-\wd\@tempboxa-2em\relax}
      \raggedleft\fontsize{7.5}{10}\selectfont
      \ifx\@wakarueyebrow\empty\else\wakarulabel{\@wakarueyebrow}\par\fi
      \ifx\@date\empty\else\wakarulabel{\@date}\par\fi
    \end{minipage}\par
    \vspace{8pt}%
    \noindent
    \wakarubox[pad=11pt]{%
      \raggedright
      % the emblem sits in the card's corner, and the title wraps short of it
      \begin{minipage}[t]{\dimexpr\linewidth-52pt\relax}
        \raggedright
        {\sffamily\bfseries\fontsize{18}{22.5}\selectfont\@title\par}
      \end{minipage}\hfill
      \raisebox{-27pt}[0pt]{\wakaruswords{40pt}}\par
      \vspace{10pt}
      {\normalfont\sffamily\normalsize\@author\par}
    }%
  }\par
  \vspace{12pt}
  \endgroup
}

% Abstract: the kit's box at the small radius, labelled with a chip.
\renewenvironment{abstract}{%
  \par\noindent
  \wakaruframe[pad=10pt]%
    \wakaruchip{Abstract}\par\vspace{5pt}%
    \small\ignorespaces
}{%
  \endwakaruframe
  \par\vspace{12pt}
}

%% ---- sections: bold, with the number in pink -------------------------------------

\RequirePackage{titlesec}

\titleformat{\section}
  {\sffamily\Large\bfseries}
  {\textcolor{wakarupink}{\thesection}}
  {0.7em}{}
\titlespacing*{\section}{0pt}{22pt plus 4pt minus 2pt}{9pt}

\titleformat{\subsection}
  {\sffamily\large\bfseries}
  {\textcolor{wakarupink}{\thesubsection}}
  {0.7em}{}
\titlespacing*{\subsection}{0pt}{16pt plus 3pt minus 2pt}{6pt}

% run-in: the gap after the period goes in \titlespacing's after-sep, since
% titlesec drops trailing glue from a run-in title's after-code
\titleformat{\subsubsection}[runin]
  {\sffamily\normalsize\bfseries}
  {}{0pt}{}[.]
\titlespacing*{\subsubsection}{0pt}{12pt plus 2pt}{0.6em}

% run-in paragraph heads in the heading face, with article's spacing
\titleformat{\paragraph}[runin]
  {\sffamily\normalsize\bfseries}
  {}{0pt}{}
\titlespacing*{\paragraph}{0pt}{3.25ex plus 1ex minus 0.2ex}{1em}

%% ---- running heads and the folio ------------------------------------------------------

\RequirePackage{fancyhdr}

% \imprint{...}: a line at the foot of the first page, empty by default.
\newcommand{\@wakaruimprint}{}
\newcommand{\imprint}[1]{\renewcommand{\@wakaruimprint}{#1}}

\newcommand{\@wakarurunning}{}
\newcommand{\runningtitle}[1]{\renewcommand{\@wakarurunning}{#1}}

% The head's wordmark is drawn once and reused on every page.
\newsavebox{\wk@headmark}
\AtBeginDocument{\sbox{\wk@headmark}{\wakarulogo{6.2pt}}}

% \wakarufolio: the page number on a small kit box -- a field of
% wakarufolio, the black border and the hard shadow -- at least as wide as
% three digits, so that the box keeps one size through a document.
\newcommand{\wakarufolio}{%
  \begingroup
  \sbox{\wk@chip}{\sffamily\bfseries\fontsize{7.5}{9}\selectfont\thepage}%
  \sbox{\@tempboxa}{\sffamily\bfseries\fontsize{7.5}{9}\selectfont 000}%
  \ifdim\wd\wk@chip>\wd\@tempboxa \sbox{\@tempboxa}{\usebox{\wk@chip}}\fi
  \edef\wk@fw{\the\dimexpr\wd\@tempboxa+9pt\relax}%
  \edef\wk@fs{\the\dimexpr\wk@fw+0.9pt\relax}%
  \begin{tikzpicture}[baseline=0pt]
    \fill[black, rounded corners=3pt] (0.9pt,-4.4pt) rectangle (\wk@fs,7.6pt);
    \path[fill=wakarufolio, draw=black, line width=0.75pt, rounded corners=2.6pt]
      (0.375pt,-3.125pt) rectangle (\the\dimexpr\wk@fw-0.375pt\relax,8.125pt);
    \node[anchor=base, inner sep=0pt, outer sep=0pt, text=black]
      at (\the\dimexpr0.5\dimexpr\wk@fw\relax\relax,0pt) {\usebox{\wk@chip}};
  \end{tikzpicture}%
  \endgroup
}

\fancypagestyle{firstpage}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[L]{\mutedlabel{\@wakaruimprint}}%
  \fancyfoot[R]{\wakarufolio}%
}
% the head: the wordmark, the running title as typed, and under them a
% rule of the box's border weight
\fancypagestyle{wakaru}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{1.5pt}%
  \fancyhead[L]{\usebox{\wk@headmark}}%
  \fancyhead[R]{{\sffamily\footnotesize\@wakarurunning}}%
  \fancyfoot[R]{\wakarufolio}%
}
\pagestyle{wakaru}

%% ---- figures, tables, captions ------------------------------------------------------

\RequirePackage{graphicx}
\RequirePackage{array}
\RequirePackage{booktabs}

% Table column heads in the heading face. array builds every cell through
% \insert@column (\insert@pcolumn for paragraph columns), so a protected
% hook put in front of both starts every cell. It sets Noto Sans from a
% \toprule to the next \midrule or \bottomrule, which is where a booktabs
% table keeps its column heads, and does nothing elsewhere or in math.
\newcommand{\wk@cellfont}{}
\protected\def\wk@cellstyle{\ifmmode\else\wk@cellfont\fi}
\let\wk@insert@column\insert@column
\def\insert@column{\wk@cellstyle\wk@insert@column}
\let\wk@insert@pcolumn\insert@pcolumn
\def\insert@pcolumn{\wk@cellstyle\wk@insert@pcolumn}
\newcommand{\wk@headon}{\noalign{\global\let\wk@cellfont\sffamily}}
\newcommand{\wk@headoff}{\noalign{\global\let\wk@cellfont\@empty}}
\let\wk@toprule\toprule
\def\toprule{\wk@headon\wk@toprule}
\let\wk@midrule\midrule
\def\midrule{\wk@headoff\wk@midrule}
\let\wk@bottomrule\bottomrule
\def\bottomrule{\wk@headoff\wk@bottomrule}
\RequirePackage[
  format=plain,
  font=small,
  justification=raggedright,
  singlelinecheck=false,
]{caption}

% the label is a chip: "Figure 1" in white on black, then the text
\DeclareCaptionLabelFormat{wakaru}{\wakaruchip{#1~#2}}
\DeclareCaptionLabelSeparator{wakaru}{\hspace{0.6em}}
\captionsetup{labelformat=wakaru, labelsep=wakaru}
\captionsetup[table]{position=above, skip=7pt}

%% ---- quotations: the kit's box on lemon, and these may break across pages -------------

% TikZ draws mdframed's rounded corners and shadow; it is a package option,
% since mdframed loads the method's code in the preamble. mdframed draws
% its shadow as TikZ's drop shadow, offset by shadowsize minus 2pt, so
% 3.125pt is the kit's 1.125pt; and the kit's shadow is hard, so shadows
% are opaque.
\RequirePackage[framemethod=TikZ]{mdframed}
\usetikzlibrary{shadows}
\tikzset{every shadow/.style={opacity=1}}
\newmdenv[
  linecolor=black, linewidth=1.5pt, roundcorner=7.5pt,
  backgroundcolor=wakarulemon,
  shadow=true, shadowcolor=black, shadowsize=3.125pt,
  innerleftmargin=10pt, innerrightmargin=10pt,
  innertopmargin=8pt, innerbottommargin=8pt,
  leftmargin=0pt, rightmargin=1.125pt, skipabove=12pt, skipbelow=12pt,
]{wakaruquote}

%% ---- code: listings, never minted (arXiv: no shell-escape) ----------------------------

\RequirePackage{listings}
\lstset{
  basicstyle=\ttfamily\footnotesize,
  keywordstyle=\color{wakarupinkdark},
  commentstyle=\color{wakarumuted},  % upright: Noto Sans Mono has no italic
  stringstyle=\color{wakarupinkdeep},
  numberstyle=\tiny\color{wakarumuted},
  backgroundcolor=\color{wakaruice},
  frame=single, framerule=1.125pt, rulecolor=\color{black}, framesep=6pt,
  xleftmargin=7.125pt, xrightmargin=7.125pt,
  aboveskip=12pt, belowskip=12pt,
  breaklines=true, showstringspaces=false,
  columns=fullflexible, keepspaces=true,
}

%% ---- theorems ----------------------------------------------------------------------------

\newtheoremstyle{wakaru}
  {10pt}{10pt}
  {\itshape}
  {}
  {\sffamily\bfseries}
  {.}
  {0.6em}
  {}
\theoremstyle{wakaru}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{remark}[theorem]{Remark}

